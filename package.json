{
  "name": "global-watch-coffee",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @global-watch/web dev",
    "dev:worker": "pnpm --filter @global-watch/geo-worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:geo": "pnpm --filter @global-watch/geo-worker test",
    "auth:migrate": "pnpm --filter @global-watch/web auth:migrate",
    "check:files": "python scripts/check_repository.py",
    "db:generate": "pnpm --filter @global-watch/web db:generate",
    "db:validate": "pnpm --filter @global-watch/web db:validate",
    "db:deploy": "pnpm --filter @global-watch/web db:deploy",
    "db:status": "pnpm --filter @global-watch/web db:status",
    "db:baseline": "pnpm --filter @global-watch/web db:baseline",
    "test:web": "pnpm --filter @global-watch/web test",
    "test:db": "pnpm --filter @global-watch/web test:db",
    "test:browser": "pnpm --filter @global-watch/web test:browser"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
