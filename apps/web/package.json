{
  "name": "@global-watch/web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "auth:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline": "prisma migrate resolve --applied 0_existing_schema",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.integration.test.ts",
    "test:browser": "playwright test",
    "test:retention:live": "node --env-file=.env.local --import tsx scripts/retention-live.ts",
    "test:gemini:live": "node --env-file=.env.local --import tsx scripts/gemini-live.ts",
    "release:check": "node --import tsx scripts/release-preflight.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "^2.76.0",
    "better-auth": "^1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.15",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "17.2.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
