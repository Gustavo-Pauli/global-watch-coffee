{
  "name": "@global-watch/geo-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-python.mjs -m uvicorn geo_worker.server:app --app-dir src --reload --host 127.0.0.1 --port 8000",
    "start": "node scripts/run-python.mjs -m uvicorn geo_worker.server:app --app-dir src --host 0.0.0.0 --port 8000",
    "test": "node scripts/run-python.mjs -m pytest -q tests",
    "typecheck": "node scripts/run-python.mjs -m compileall -q src tests"
  }
}
