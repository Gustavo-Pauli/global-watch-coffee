{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL", "DIRECT_URL", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET",
    "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "SUPABASE_URL",
    "SUPABASE_SECRET_KEY", "SUPABASE_SERVICE_ROLE_KEY", "SUPABASE_STORAGE_BUCKET",
    "PYTHON_WORKER_URL", "WORKER_SECRET", "NEXT_CALLBACK_URL", "CRON_SECRET",
    "GEMINI_API_KEY", "GEMINI_MODEL", "TEST_DATABASE_URL", "NEXT_PUBLIC_MAPTILER_KEY"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
